# AegisAI Environment Configuration Template
# Copy this file to .env and configure your environment variables.
# DO NOT commit .env with real credentials to GitHub.

# AWS S3 Immutable Compliance Vault Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID_HERE
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY_HERE
AWS_S3_BUCKET_NAME=aegisai-immutable-audit-vault
AWS_VAULT_ENABLED=false

# Optional Security / Token Settings
# AEGISAI_QUORUM_SECRET=your-random-32-byte-secret

# Deployed URL & CORS Configuration
FRONTEND_URL=https://main.d2rqrw62mxd6iz.amplifyapp.com
BACKEND_URL=https://aegisai-backend-l0zn.onrender.com
CORS_ORIGINS=https://main.d2rqrw62mxd6iz.amplifyapp.com,http://localhost:5173,http://127.0.0.1:5173
